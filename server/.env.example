# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string. Render provisions this for you; locally, point
# it at your own database.
DATABASE_URL=postgres://user:password@localhost:5432/candlemere

# Signing key for session tokens. Anyone who knows this can mint a token for
# any account, so generate a long random value and keep it secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if this is unset.
JWT_SECRET=

# Origin allowed to call the API and open sockets (CORS). Must match where the
# client is actually served from.
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" on a deployed server. This turns on the strict checks
# (no fallback signing key, TLS certificate verification for Postgres).
NODE_ENV=development

PORT=4000
